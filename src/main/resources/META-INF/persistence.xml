<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence">
  <persistence-unit name="cinema">
    <class>model.Movie</class>
    <class>model.Showtime</class>
    <class>model.Room</class>
    <properties>
      <!-- Example credentials. Override them with -Ddb.user and -Ddb.password (see README). -->
      <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/cinema"/>
      <property name="jakarta.persistence.jdbc.user" value="root"/>
      <property name="jakarta.persistence.jdbc.password" value="root"/>
      <property name="hibernate.hbm2ddl.auto" value="update"/>
      <property name="hibernate.show_sql" value="true"/>
    </properties>
  </persistence-unit>
</persistence>
